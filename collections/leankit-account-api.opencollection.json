{
  "opencollection": "1.0.0",
  "info": {
    "name": "Planview AgilePlace API (LeanKit) v2 account API",
    "version": "v2"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "account",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get account settings",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{account}.leankit.com/io/account"
          },
          "docs": "Get account settings. Example Request"
        },
        {
          "info": {
            "name": "Update my account settings",
            "type": "http"
          },
          "http": {
            "method": "PATCH",
            "url": "https://{account}.leankit.com/io/account",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Update my account settings. Example Request Body (title only)"
        }
      ]
    }
  ],
  "bundled": true
}