{
  "opencollection": "1.0.0",
  "info": {
    "name": "Planview AgilePlace API (LeanKit) v2 account attachment API",
    "version": "v2"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "attachment",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get a list of attachments for a card",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{account}.leankit.com/io/card/:cardId/attachment",
            "params": [
              {
                "name": "cardId",
                "value": "",
                "type": "path",
                "description": "cardId identifier"
              }
            ]
          },
          "docs": "Get a list of attachments for a card. Example Request"
        },
        {
          "info": {
            "name": "Create an attachment",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://{account}.leankit.com/io/card/:cardId/attachment",
            "params": [
              {
                "name": "cardId",
                "value": "",
                "type": "path",
                "description": "cardId identifier"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Create an attachment. Example Request"
        },
        {
          "info": {
            "name": "Delete an attachment",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://{account}.leankit.com/io/card/:cardId/attachment/:attachmentId",
            "params": [
              {
                "name": "cardId",
                "value": "",
                "type": "path",
                "description": "cardId identifier"
              },
              {
                "name": "attachmentId",
                "value": "",
                "type": "path",
                "description": "attachmentId identifier"
              }
            ]
          },
          "docs": "Delete an attachment. Example Request"
        },
        {
          "info": {
            "name": "Get an attachment's contents",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{account}.leankit.com/io/card/:cardId/attachment/:attachmentId/content",
            "params": [
              {
                "name": "cardId",
                "value": "",
                "type": "path",
                "description": "cardId identifier"
              },
              {
                "name": "attachmentId",
                "value": "",
                "type": "path",
                "description": "attachmentId identifier"
              }
            ]
          },
          "docs": "Get an attachment's contents. Example Request"
        }
      ]
    }
  ],
  "bundled": true
}