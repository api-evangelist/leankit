{
  "opencollection": "1.0.0",
  "info": {
    "name": "Planview AgilePlace API (LeanKit) v2 account tags API",
    "version": "v2"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "tags",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get a list of tags on a board",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{account}.leankit.com/io/board/:boardId/tag",
            "params": [
              {
                "name": "boardId",
                "value": "",
                "type": "path",
                "description": "boardId identifier"
              }
            ]
          },
          "docs": "Get a list of tags on a board. The response contains a key for each tag where the value is the number of times the tag is used on the board. Example Request"
        },
        {
          "info": {
            "name": "Delete a tag on a board",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://{account}.leankit.com/io/board/:boardId/tag",
            "params": [
              {
                "name": "boardId",
                "value": "",
                "type": "path",
                "description": "boardId identifier"
              }
            ]
          },
          "docs": "Delete a tag on a board. Requires"
        },
        {
          "info": {
            "name": "Rename or merge tags on a board",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://{account}.leankit.com/io/board/:boardId/tag/replace",
            "params": [
              {
                "name": "boardId",
                "value": "",
                "type": "path",
                "description": "boardId identifier"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Rename or merge tags on a board. Requires"
        }
      ]
    }
  ],
  "bundled": true
}