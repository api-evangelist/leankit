{
  "opencollection": "1.0.0",
  "info": {
    "name": "Planview AgilePlace API (LeanKit) v2 account board-level API",
    "version": "v2"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "board-level",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List board levels",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{account}.leankit.com/io/boardLevel"
          },
          "docs": "List board levels. Example Request"
        },
        {
          "info": {
            "name": "Create, update, or delete board levels",
            "type": "http"
          },
          "http": {
            "method": "PUT",
            "url": "https://{account}.leankit.com/io/boardLevel",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Create, update, or delete board levels. All levels need to be included in the payload. Levels without an id will be created. Missing levels will be deleted."
        }
      ]
    }
  ],
  "bundled": true
}