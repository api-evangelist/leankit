            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Update an existing planning increment. Requires the Account Administrator or Team Organizer account role."
        },
        {
          "info": {
            "name": "Delete a planning increment by id",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://{account}.leankit.com/io/series/:seriesId/increment/:incrementId",
            "params": [
              {
                "name": "seriesId",
                "value": "",
                "type": "path",
                "description": "seriesId identifier"
              },
              {
                "name": "incrementId",
                "value": "",
                "type": "path",
                "description": "incrementId identifier"
              }
            ]
          },
          "docs": "Delete a planning increment by id. Requires the Account Administrator or Team Organizer account role."
        },
        {
          "info": {
            "name": "Enumerates the total number of cards and the number of blocked cards in the increment by status category",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{account}.leankit.com/io/series/:seriesId/increment/:incrementId/status",
            "params": [
              {
                "name": "seriesId",
                "value": "",
                "type": "path",
                "description": "seriesId identifier"
              },
              {
                "name": "incrementId",
                "value": "",
                "type": "path",
                "description": "incrementId identifier"
              }
            ]
          },
          "docs": "Enumerates the total number of cards and the number of blocked cards in the increment by status category. Path Parameters"
        },
        {
          "info": {
            "name": "List the cardIds of cards in the increment that are currently in the increment status category specified by the :categor",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{account}.leankit.com/io/series/:seriesId/increment/:incrementId/status/:category",
            "params": [
              {
                "name": "seriesId",
                "value": "",
                "type": "path",
                "description": "seriesId identifier"
