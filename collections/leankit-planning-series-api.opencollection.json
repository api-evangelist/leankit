{
  "opencollection": "1.0.0",
  "info": {
    "name": "Planview AgilePlace API (LeanKit) v2 account planning-series API",
    "version": "v2"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "planning-series",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get a list of planning series for an account",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{account}.leankit.com/io/series"
          },
          "docs": "Get a list of planning series for an account. Query Params"
        },
        {
          "info": {
            "name": "Create a new planning series",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://{account}.leankit.com/io/series",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Create a new planning series. Requires the Account Administrator or Team Organizer account role."
        },
        {
          "info": {
            "name": "Get a planning series by id",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{account}.leankit.com/io/series/:seriesId",
            "params": [
              {
                "name": "seriesId",
                "value": "",
                "type": "path",
                "description": "seriesId identifier"
              }
            ]
          },
          "docs": "Get a planning series by id. Example Request"
        },
        {
          "info": {
            "name": "Update an existing planning series",
            "type": "http"
          },
          "http": {
            "method": "PATCH",
            "url": "https://{account}.leankit.com/io/series/:seriesId",
            "params": [
              {
                "name": "seriesId",
                "value": "",
                "type": "path",
                "description": "seriesId identifier"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Update an existing planning series. Requires the Account Administrator or Team Organizer account role."
        },
        {
          "info": {
            "name": "Delete a series by id",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://{account}.leankit.com/io/series/:seriesId",
            "params": [
              {
                "name": "seriesId",
                "value": "",
                "type": "path",
                "description": "seriesId identifier"
              }
            ]
          },
          "docs": "Delete a series by id. Requires the Account Administrator or Team Organizer account role."
        },
