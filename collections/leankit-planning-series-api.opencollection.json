          "info": {
            "name": "Update an existing planning increment",
            "type": "http"
          },
          "http": {
            "method": "PATCH",
            "url": "https://{account}.leankit.com/io/series/:seriesId/increment/:incrementId",
            "params": [
              {
                "name": "seriesId",
                "value": "",
                "type": "path",
                "description": "seriesId identifier"
              },
              {
                "name": "incrementId",
                "value": "",
