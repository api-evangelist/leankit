{
  "opencollection": "1.0.0",
  "info": {
    "name": "Planview AgilePlace API (LeanKit) v2 account card-scoring API",
    "version": "v2"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "card-scoring",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get the current state of the user's card scoring for a board",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{account}.leankit.com/io/board/:boardId/scoring",
            "params": [
              {
                "name": "boardId",
                "value": "",
                "type": "path",
                "description": "boardId identifier"
              }
            ]
          },
          "docs": "Get the current state of the user's card scoring for a board. Example Request"
        }
      ]
    }
  ],
  "bundled": true
}