                "description": "cardId identifier"
              }
            ]
          },
          "docs": "Get a list of comments for a card. Query Params"
        },
        {
          "info": {
            "name": "Create a comment",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://{account}.leankit.com/io/card/:cardId/comment",
            "params": [
              {
                "name": "cardId",
                "value": "",
                "type": "path",
                "description": "cardId identifier"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Create a comment. Example Request"
