        {
          "info": {
            "name": "Delete a comment",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://{account}.leankit.com/io/card/:cardId/comment/:commentId",
            "params": [
              {
                "name": "cardId",
                "value": "",
                "type": "path",
                "description": "cardId identifier"
              },
              {
                "name": "commentId",
                "value": "",
                "type": "path",
                "description": "commentId identifier"
              }
